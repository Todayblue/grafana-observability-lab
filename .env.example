# Copy to .env, then set strong GRAFANA_ADMIN_PASSWORD and GRAFANA_SECRET_KEY.
# start.sh does not generate passwords. Never commit .env.
# This file is for local reference only, not production secret management.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=

# Optional OTLP endpoint for a generic .NET process on the same Mac host:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
GRAFANA_PORT=13305
PROMETHEUS_PORT=19095
LOKI_PORT=13105
TEMPO_PORT=13205
ALLOY_UI_PORT=12355
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
DEMO_API_PORT=18085
